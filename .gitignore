# ==========================================
# WeViewCam Multi-platform Repository .gitignore
# ==========================================

# OS / Editor Files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.iml
*.swp
*.swo

# Development documentation & plans
docs/
doc/

# ==========================================
# Android Build & Temporary Files
# ==========================================
.gradle/
build/
app/build/
local.properties
.cxx/
captures/
.externalNativeBuild/

# Android Large SDK Archives & Sample Demos
WeViewCam_android/HCNetSDK*.zip
WeViewCam_android/HCNetSDKV6.1.11.5*

# Allow release and debug APK in repo root and WeViewCam_android
!*.apk
!WeViewCam_android/*.apk

# ==========================================
# Ubuntu / Python Temporary Files
# ==========================================
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
ENV/
env/

# Large raw vendor SDK archives (Runtime libs are kept in WeViewCam_ubuntu/sdk/hikvision/lib)
WeViewCam_ubuntu/HCNetSDK*.zip
WeViewCam_ubuntu/HCNetSDKV6.1.11.30*

# Logs
logs/
*.log
