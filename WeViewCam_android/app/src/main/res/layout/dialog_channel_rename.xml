<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_rounded"
    android:padding="20dp">

    <TextView
        android:id="@+id/tv_rename_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="修改通道名称"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_rename_channel_no"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="目标通道: 通道 1"
        android:textColor="@color/primary_light"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="通道名称"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/et_channel_new_name"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_control_button"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:textSize="14sp"
        android:singleLine="true"
        android:inputType="text" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btn_rename_cancel"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="取消"
            android:textSize="12sp"
            android:layout_marginEnd="8dp"
            style="@style/SurveillanceButton" />

        <Button
            android:id="@+id/btn_rename_save"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="保存"
            android:textSize="12sp"
            style="@style/SurveillanceAccentButton" />
    </LinearLayout>

</LinearLayout>
